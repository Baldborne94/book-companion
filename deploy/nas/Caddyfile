{
	auto_https off
	admin off
}

# L'HTTPS lo termina Tailscale (certificato valido *.ts.net): qui dentro basta HTTP.
:80 {
	encode zstd gzip

	# La cartella Biblioteca del NAS, in sola lettura, sulla stessa origine dell'app:
	# niente CORS né mixed content. Con "Accept: application/json" l'elenco
	# della cartella torna in JSON.
	handle_path /biblioteca/* {
		root * /srv/biblioteca
		file_server browse
	}

	handle {
		root * /srv/app

		# sw.js e index.html mai in cache HTTP: altrimenti il banner "nuova versione"
		# non arriva finché il browser non decide di rivalidare.
		@nocache path /sw.js /index.html / /manifest.json /registerSW.js
		header @nocache Cache-Control "no-cache"
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
