# Copia in deploy/nas/.env e compila. Il file .env non va mai nel repository.

# La cartella condivisa con dentro Libri, Fumetti, Manga
BIBLIOTECA_PATH=/volume1/Biblioteca

# L'app sarà su https://book-companion.<rete>.ts.net
TS_HOSTNAME=book-companion
# Chiave da https://login.tailscale.com/admin/settings/keys (non reusable, non ephemeral)
TS_AUTHKEY=

# L'indirizzo intero dell'app (serve a Supabase e alla build)
SUPABASE_PUBLIC_URL=https://book-companion.<rete>.ts.net

# Le quattro righe qui sotto non si scrivono a mano: le genera chiavi.mjs (vedi README)
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
