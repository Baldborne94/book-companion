# Copia in deploy/nas/.env e compila.

# Percorso della cartella condivisa "Biblioteca" sul NAS (vedi README per trovarlo).
BIBLIOTECA_PATH=/volume1/Biblioteca

# Nome macchina nella tailnet → l'app sarà su https://book-companion.<tailnet>.ts.net
TS_HOSTNAME=book-companion

# Auth key da https://login.tailscale.com/admin/settings/keys (Reusable: no, Ephemeral: no)
TS_AUTHKEY=

# Opzionali: stesse chiavi Supabase di Vercel, se vuoi la sync anche dalla versione NAS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
